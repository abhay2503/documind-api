{
  "name": "documind-api",
  "version": "0.1.0",
  "private": true,
  "description": "DocuMind AI frontend-facing API (Node.js + TypeScript on AWS Lambda). AI processing lives in the separate Python project.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "offline": "serverless offline --stage local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:prod": "node --env-file=.env.prod scripts/migrate.mjs",
    "package:prod": "serverless package --stage prod",
    "deploy:prod": "serverless deploy --stage prod",
    "test:localstack": "RUN_INTEGRATION=1 vitest run tests/integration/localstack.test.ts",
    "localstack:up": "docker compose up -d --wait",
    "localstack:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/client-sqs": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-sdk-client-mock": "4.1.0",
    "serverless": "4.46.0",
    "serverless-offline": "14.8.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
