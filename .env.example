# Copy to .env (local) or .env.prod (production). Never commit real values.
NODE_ENV=development
AWS_REGION=ap-south-1

# PostgreSQL. Local: the Postgres server on this machine. Cloud (Aiven): host/port/user from the Aiven
# console, DB_SSLMODE=require. DB_SSLMODE: disable | require | verify-full (verify-full also needs DB_SSL_CA = CA cert PEM).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=documind
DB_SSLMODE=disable
DB_CONNECTION_LIMIT=2

# S3 / SQS
S3_BUCKET_NAME=documind-documents-local
SQS_QUEUE_URL=http://localhost:4566/000000000000/documind-summary-queue-local

# Local only: LocalStack endpoint for S3/SQS. Leave EMPTY (or remove) in .env.prod.
LOCAL_AWS_ENDPOINT=http://localhost:4566

# Browser origin allowed by API Gateway CORS and the S3 bucket CORS (the frontend URL)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Existing Cognito User Pool + public App Client (no client secret). Used only by serverless.yml to
# configure the API Gateway JWT authorizer; Lambda code never reads them.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Uploads
UPLOAD_URL_EXPIRES_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# Production deploy only (.env.prod): SQS visibility timeout; must be >= 6x the Python worker's Lambda timeout
SQS_VISIBILITY_TIMEOUT_SECONDS=5400
